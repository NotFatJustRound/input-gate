{
  "name": "input-gate",
  "version": "2.1.0",
  "description": "给 agent 的外部输入套一道闸：来源横幅、长度封顶、注入规则；硬规则命中时正文整段不交付。DeepSeek Harness 插件。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./gate": "./lib/gate.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "policy.example.json",
    "gate.py",
    "tests",
    "README.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test tests/gate.test.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "prompt-injection",
    "untrusted-input"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "author": "NotFatJustRound",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NotFatJustRound/input-gate.git"
  },
  "bugs": {
    "url": "https://github.com/NotFatJustRound/input-gate/issues"
  }
}
